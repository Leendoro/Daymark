
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daymark.ViewModels"
        xmlns:models="using:Daymark.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="Daymark.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Daymark">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>

        <!-- HOME SCREEN -->
        <StackPanel
            IsVisible="{Binding IsHomeVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="15">

            <TextBlock
                Text="DAYMARK"
                FontSize="36"
                FontWeight="Bold"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Your journal starts here."
                FontSize="18"
                HorizontalAlignment="Center" />

            <Button
                Content="New Entry"
                Command="{Binding NewEntryCommand}"
                HorizontalAlignment="Center" />

            <Button
                Content="My Library"
                Command="{Binding OpenLibraryCommand}"
                HorizontalAlignment="Center" />

        </StackPanel>

        <!-- JOURNAL EDITOR / READER -->
        <Grid
            IsVisible="{Binding IsWritingEntry}"
            Margin="50"
            RowDefinitions="Auto,*,Auto,Auto"
            RowSpacing="12">

            <TextBlock
                Grid.Row="0"
                Text="{Binding EditorHeading}"
                FontSize="30"
                FontWeight="Bold" />

            <!-- SCROLLABLE JOURNAL CONTENT -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="15">

                    <!-- TITLE -->
                    <TextBox
                        Text="{Binding EntryTitle, Mode=TwoWay}"
                        IsReadOnly="{Binding IsEditorReadOnly}"
                        PlaceholderText="Entry title..." />

                    <!-- TEXT CONTENT -->
                    <TextBox
                        Text="{Binding EntryContent, Mode=TwoWay}"
                        IsReadOnly="{Binding IsEditorReadOnly}"
                        PlaceholderText="Start writing..."
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="200" />

                    <!-- IMAGE PREVIEWS -->
                    <ItemsControl
                        ItemsSource="{Binding JournalImages}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,5,0,10"
                                    Padding="8"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                    <Image
                                        Source="{Binding}"
                                        MaxWidth="650"
                                        MaxHeight="400"
                                        Stretch="Uniform"
                                        HorizontalAlignment="Left" />

                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- ADD IMAGE -->
            <Button
                Grid.Row="2"
                Content="Add Image"
                Click="AddImage_Click"
                IsVisible="{Binding CanAddImage}"
                HorizontalAlignment="Left" />

            <!-- NORMAL EDITOR BUTTONS -->
            <StackPanel
                Grid.Row="3"
                Orientation="Horizontal"
                Spacing="10"
                IsVisible="{Binding IsNotConfirmingDelete}">

                <Button
                    Content="Back"
                    Command="{Binding GoHomeCommand}"
                    IsVisible="{Binding IsCreatingEntry}" />

                <Button
                    Content="Save Entry"
                    Command="{Binding SaveEntryCommand}"
                    IsVisible="{Binding IsCreatingEntry}" />

                <Button
                    Content="Back to Library"
                    Command="{Binding BackToLibraryCommand}"
                    IsVisible="{Binding IsExistingEntry}" />

                <Button
                    Content="Edit Entry"
                    Command="{Binding EditEntryCommand}"
                    IsVisible="{Binding IsReadingEntry}" />

                <Button
                    Content="Save Changes"
                    Command="{Binding SaveChangesCommand}"
                    IsVisible="{Binding IsEditingEntry}" />

                <Button
                    Content="Cancel Editing"
                    Command="{Binding CancelEditingCommand}"
                    IsVisible="{Binding IsEditingEntry}" />

                <Button
                    Content="Delete Entry"
                    Command="{Binding DeleteEntryCommand}"
                    IsVisible="{Binding IsReadingEntry}" />

            </StackPanel>

            <!-- DELETE CONFIRMATION -->
            <StackPanel
                Grid.Row="3"
                IsVisible="{Binding IsConfirmingDelete}"
                Spacing="12">

                <TextBlock
                    Text="Are you sure you want to delete this journal entry?"
                    FontSize="18"
                    FontWeight="Bold"
                    TextWrapping="Wrap" />

                <TextBlock
                    Text="This action cannot be undone."
                    FontSize="14"
                    Opacity="0.7" />

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10">

                    <Button
                        Content="Yes, Delete Entry"
                        Command="{Binding ConfirmDeleteCommand}" />

                    <Button
                        Content="Cancel"
                        Command="{Binding CancelDeleteCommand}" />

                </StackPanel>

            </StackPanel>

        </Grid>

        <!-- JOURNAL LIBRARY -->
        <StackPanel
            IsVisible="{Binding IsViewingLibrary}"
            Margin="50"
            Spacing="15">

            <TextBlock
                Text="My Library"
                FontSize="30"
                FontWeight="Bold" />

            <TextBlock
                Text="Your saved journal entries:"
                FontSize="16" />

            <ListBox
                ItemsSource="{Binding JournalEntries}"
                SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                Height="350">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:JournalEntry">

                        <StackPanel
                            Margin="10"
                            Spacing="5">

                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="20"
                                FontWeight="Bold" />

                            <TextBlock
                                Text="{Binding CreatedAt}"
                                FontSize="12"
                                Opacity="0.7" />

                        </StackPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <Button
                Content="Back to Home"
                Command="{Binding GoHomeCommand}"
                HorizontalAlignment="Left" />

        </StackPanel>

    </Grid>

</Window>
