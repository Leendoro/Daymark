
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daymark.ViewModels"
        xmlns:models="using:Daymark.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="450"
        x:Class="Daymark.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Daymark">

    <Design.DataContext>
        <!-- Used for the IDE previewer -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>

        <!-- HOME SCREEN -->
        <StackPanel
            IsVisible="{Binding IsHomeVisible}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="15">

            <TextBlock
                Text="DAYMARK"
                FontSize="36"
                FontWeight="Bold"
                HorizontalAlignment="Center" />

            <TextBlock
                Text="Your journal starts here."
                FontSize="18"
                HorizontalAlignment="Center" />

            <Button
                Content="New Entry"
                Command="{Binding NewEntryCommand}"
                HorizontalAlignment="Center" />

            <Button
                Content="My Library"
                Command="{Binding OpenLibraryCommand}"
                HorizontalAlignment="Center" />

        </StackPanel>


        <!-- JOURNAL EDITOR -->
        <StackPanel
            IsVisible="{Binding IsWritingEntry}"
            Margin="50"
            Spacing="15">

            <TextBlock
                Text="New Journal Entry"
                FontSize="30"
                FontWeight="Bold" />

            <!-- Journal title -->
            <TextBox
                Text="{Binding EntryTitle, Mode=TwoWay}"
                PlaceholderText="Entry title..." />

            <!-- Journal content -->
            <TextBox
                Text="{Binding EntryContent, Mode=TwoWay}"
                PlaceholderText="Start writing..."
                AcceptsReturn="True"
                TextWrapping="Wrap"
                Height="250" />

            <!-- Navigation and saving -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="10">

                <Button
                    Content="Back"
                    Command="{Binding GoHomeCommand}" />

                <Button
                    Content="Save Entry"
                    Command="{Binding SaveEntryCommand}" />

            </StackPanel>

        </StackPanel>


        <!-- JOURNAL LIBRARY -->
        <StackPanel
            IsVisible="{Binding IsViewingLibrary}"
            Margin="50"
            Spacing="15">

            <TextBlock
                Text="My Library"
                FontSize="30"
                FontWeight="Bold" />

            <TextBlock
                Text="Your saved journal entries:"
                FontSize="16" />

            <!-- Displays entries loaded from journals.json -->
            <ListBox
                ItemsSource="{Binding JournalEntries}"
                Height="350">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:JournalEntry">

                        <StackPanel
                            Margin="10"
                            Spacing="5">

                            <!-- Journal title -->
                            <TextBlock
                                Text="{Binding Title}"
                                FontSize="20"
                                FontWeight="Bold" />

                            <!-- Journal creation date -->
                            <TextBlock
                                Text="{Binding CreatedAt}"
                                FontSize="12"
                                Opacity="0.7" />

                        </StackPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

            <!-- Return to home screen -->
            <Button
                Content="Back to Home"
                Command="{Binding GoHomeCommand}"
                HorizontalAlignment="Left" />

        </StackPanel>

    </Grid>

</Window>
